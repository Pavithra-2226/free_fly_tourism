# MongoDB connection string (do NOT commit the real value)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=free_fly_tourism

# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin authentication (required - the app refuses admin requests until these are set)
# Do NOT commit real values. Generate ADMIN_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET_KEY=change-me-too
ADMIN_TOKEN_EXPIRE_MINUTES=480
